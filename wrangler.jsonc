{
  "name": "nowplaying",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "triggers": { "crons": ["* * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }]
}
